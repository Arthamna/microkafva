{
    // to compile cdk.out in current directory, integrated with 
    // run command
    "version": "0.2.0",
    "configurations": [
      {
        "type": "java",
        "name": "LocalStack",
        "request": "launch",
        "mainClass": "com.pm.stack.LocalStack",
        "cwd": "${workspaceFolder}/infrastructure",
        "console": "integratedTerminal",
        "shortenCommandLine": "argfile"
      }
    ]
  }